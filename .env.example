# Supabase project: aagla-golf
# Values live in the Vercel project settings for deployed environments.

# Safe to expose to the browser. Reads are governed by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server only. Bypasses row-level security entirely -- never expose this to the
# client, never commit it, and use it only for provisioning a new league.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run db:types` to regenerate lib/types/database.ts.
SUPABASE_PROJECT_ID=your-project-ref
